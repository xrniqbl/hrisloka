# ============================================================
# HRIS Loka — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git!
#
# Deploy target: VPS (Node server/index.js + Nginx)
# See docs/VPS_DEPLOY.md — Vercel is NOT required.
# ============================================================

# ── VPS Node server ───────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
# Public site URL (used for CORS + Midtrans SITE_URL on Supabase)
SITE_URL=https://your-domain.com
# Extra CORS origins (comma-separated), e.g. staging
ALLOWED_ORIGINS=
# Daily subscription cron schedule (node-cron). Set ENABLE_CRON=false to disable.
ENABLE_CRON=true
CRON_SCHEDULE=0 0 * * *

# ── Supabase (Required) ──────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Founder Access (Required untuk /founder/* portal) ────────
# Email founder yang bisa akses Founder Portal
VITE_FOUNDER_EMAIL=founder@yourdomain.com

# ── Midtrans Payment Gateway (Required untuk checkout) ───────
# Dashboard: https://dashboard.sandbox.midtrans.com
# Client key untuk frontend Snap.js
VITE_MIDTRANS_CLIENT_KEY=Mid-client-xxxxx
VITE_MIDTRANS_IS_PRODUCTION=false
# Server key — HANYA untuk Supabase Edge Function, JANGAN pakai di frontend!
# Set di Supabase Dashboard > Edge Functions > Secrets
# MIDTRANS_SERVER_KEY=Mid-server-xxxxx

# ── Demo Mode Credentials ────────────────────────────────────
# Dipakai oleh demoGuard.js untuk intercept login demo
# JANGAN set di production!
VITE_DEMO_EMAIL=demo@hrisloka.com
VITE_DEMO_PASSWORD=your-demo-password-here

# ── PWA Push Notifications ───────────────────────────────────
# Generate VAPID keys: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# ── AI Features ──────────────────────────────────────────────
# Gemini AI — Smart Review Generator
# Get free API key: https://aistudio.google.com/app/apikey
# SECURITY: NEVER set this with VITE_ prefix! API key stays on server only.
# Set GEMINI_API_KEY (no VITE_) in Vercel/Supabase env vars.
# GEMINI_API_KEY=your-gemini-api-key-here

# ── Email Notifications (Brevo / formerly Sendinblue) ────────
# Signup: https://app.brevo.com → SMTP & API → API keys
# Free tier: ~300 emails/day (check current plan limits)
# SECURITY: NEVER set with VITE_ prefix — server only.
# BREVO_API_KEY=xkeysib-xxxxxxxx
# FROM_EMAIL=noreply@yourdomain.com   # must be verified sender in Brevo
# FROM_NAME=HRIS Loka
#
# Accepted aliases (api/send-email.js fallback chain — audit 2026-09):
#   RESEND_API_KEY   = alias of BREVO_API_KEY
#   BREVO_SMTP_KEY   = alias of BREVO_API_KEY
#   BREVO_SENDER_EMAIL = alias of FROM_EMAIL
#   BREVO_SENDER_NAME  = alias of FROM_NAME

# ── WhatsApp Notifications ───────────────────────────────────
# Option A: Fonnte (Popular di Indonesia, 500 pesan/bulan gratis)
# Signup: https://fonnte.com
# SECURITY: NEVER set this with VITE_ prefix! Token stays on server only.
# Set FONNTE_TOKEN (no VITE_) in Vercel env vars.
# FONNTE_TOKEN=your-fonnte-token-here

# Option B: Meta WhatsApp Business API — DEPRECATED/DEAD: no code consumes
# these vars (audit 2026-09). Fonnte (FONNTE_TOKEN) is the active provider.
# VITE_WA_BUSINESS_TOKEN=your-meta-wa-business-token-here
# VITE_WA_PHONE_ID=your-wa-phone-id-here

# ── Bank Validation ──────────────────────────────────────────
# API.co.id — Bank list for payslip/employee profile
# SECURITY: NEVER set this with VITE_ prefix! API key stays on server only.
# Set BANK_VALIDATION_API_KEY (no VITE_) in Vercel env vars.
# BANK_VALIDATION_API_KEY=your-api-co-id-key-here

# ── Cron Job Security ────────────────────────────────────────
# Generate random string: openssl rand -hex 32
CRON_SECRET=your-random-secret-string-here

# ── Server-side (Vercel Serverless Functions) ────────────────
# VARIABEL INI WAJIB di Vercel Production — tanpa ini API AI/email/push/WA/banks/cron
# akan gagal auth (401) atau silent-fail.
# HANYA dipakai oleh api/*.js di server, BUKAN di frontend.
# JANGAN beri prefix VITE_ agar tidak ter-bundle ke client.
# Set di Vercel Dashboard > Project > Settings > Environment Variables.
#
# Checklist production:
#   [ ] SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
#   [ ] VAPID_PUBLIC_KEY + VAPID_PRIVATE_KEY + PUSH_API_SECRET
#   [ ] BREVO_API_KEY + FROM_EMAIL (+ FROM_NAME opsional)
#   [ ] FONNTE_TOKEN (jika WhatsApp aktif)
#   [ ] GEMINI_API_KEY (jika AI review aktif)
#   [ ] CRON_SECRET
#   [ ] BANK_VALIDATION_API_KEY (opsional)

# Supabase service role (server-only, melewati RLS!)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Server-side anon key — dipakai api/send-push.js (audit 2026-09).
SUPABASE_ANON_KEY=same-value-as-VITE_SUPABASE_ANON_KEY

# Push notifications (VAPID pair — private key hanya di server!)
VAPID_PUBLIC_KEY=same-value-as-VITE_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_EMAIL=mailto:you@yourdomain.com
# Secret yang melindungi endpoint /api/send-push dari akses publik.
# Wajib di-set! Jika kosong, endpoint terbuka tanpa auth.
PUSH_API_SECRET=your-push-api-secret-here

# Brevo (server) — Transactional SMTP API
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=HRIS Loka

# Fonnte (server only — jangan pakai prefix VITE_)
FONNTE_TOKEN=your-fonnte-token-here

# Gemini AI (server only — jangan pakai prefix VITE_)
GEMINI_API_KEY=your-gemini-api-key-here

# Bank validation (server only — jangan pakai prefix VITE_)
BANK_VALIDATION_API_KEY=your-api-co-id-key-here

# ── Supabase Edge Functions (set di Supabase Dashboard) ──────
# Tidak perlu di .env lokal — set sebagai secrets di Supabase:
# - MIDTRANS_SERVER_KEY     (untuk create-payment & midtrans-webhook)
# - SUPABASE_URL            (untuk Edge Functions)
# - SUPABASE_SERVICE_ROLE_KEY (untuk Edge Functions)
# - MIDTRANS_IS_PRODUCTION  (untuk Edge Functions)
# - SITE_URL                (callback URL Midtrans, e.g. https://hrisloka.id)

# ── Superadmin seeding script (scripts/create_superadmin.js) ────────────────
# Hanya untuk seeding lokal/staging — JANGAN set di production VPS.
# FOUNDER_EMAIL=admin@yourdomain.com
# FOUNDER_PASSWORD=use-a-strong-password

# Sentry Error Tracking (optional)
# ── Error tracking (optional) ────────────────────────────────
# https://sentry.io → Project → Client Keys (DSN)
# Leave empty to disable (app still runs).
VITE_SENTRY_DSN=
# VITE_APP_VERSION=1.0.0
